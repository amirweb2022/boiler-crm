# PostgreSQL (Liara DBaaS)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_POOL_MAX=5

# Liara Object Storage (S3-compatible)
LIARA_OBJECT_STORAGE_ENDPOINT=https://storage.iran.liara.space
LIARA_OBJECT_STORAGE_REGION=us-east-1
LIARA_OBJECT_STORAGE_BUCKET=certificates
LIARA_OBJECT_STORAGE_ACCESS_KEY=
LIARA_OBJECT_STORAGE_SECRET_KEY=

# Session security
SESSION_SECRET=

# SMS
SMS_PROVIDER=mock            # mock | kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# Certificate cleanup schedule
CRON_SECRET=
CERTIFICATE_CLEAR_NEAR_DUE_DAYS=30

# Monthly reports
REPORT_INSPECTOR_NAME=اخگر صنعت پویا
REPORT_INSPECTOR_NATIONAL_ID=14010077771
NEXT_PUBLIC_APP_URL=https://boiler.liara.run/
